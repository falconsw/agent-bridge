{
  "manifest_version": 3,
  "name": "Agent Bridge",
  "version": "0.6.0",
  "description": "Terminal agent'larının (MCP üzerinden) bu tarayıcıda işlem yapmasını sağlar: okuma, tıklama, yazma, ekran görüntüsü. Yalnız localhost'a bağlanır, token ile eşleşir.",
  "permissions": [
    "alarms",
    "debugger",
    "tabs",
    "tabGroups",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Agent Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
